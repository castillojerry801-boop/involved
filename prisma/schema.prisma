  updatedAt   DateTime         @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType])
  @@index([userId])
  @@map("weekly_targets")
}

// ═════════════════════════════════════════════════════════════════════
// CUSTOM EXERCISES
// ═════════════════════════════════════════════════════════════════════

model CustomExercise {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  name         String       @db.VarChar(200)
  bodyPart     String?      @map("body_part") @db.VarChar(100)
  targetMuscle String?      @map("target_muscle") @db.VarChar(100)
  equipment    String?      @db.VarChar(100)
  trackingType TrackingType @default(strength) @map("tracking_type")
  instructions String?      @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("custom_exercises")
}

