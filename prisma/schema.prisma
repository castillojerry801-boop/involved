}

enum PRMetric {
  weight
  reps
  duration
  distance
  estimated_1rm
  volume_kg
}

// How performance is tracked for a given exercise.
// Determines which fields are shown/required during a session.
enum TrackingType {
  strength     // weight × reps (barbell, dumbbell, cable, machine)
  bodyweight   // reps only (push-up, pull-up, dip)
  assisted     // assistance weight × reps (assisted pull-up machine)
  cardio       // time + optional distance (treadmill, bike, row)
  carry        // weight + distance and/or time (farmer carry, sled)
  isometric    // time only (plank, wall sit)
  intervals    // work_seconds + rest_seconds + rounds
}

// Set classification — enables volume/intensity analysis and
// supports advanced programming like drop sets and AMRAP finishers.
enum SetType {
  warmup   // warm-up set — lighter, not counted in working volume
  working  // standard working set
  amrap    // as many reps as possible — upper bound not set
  drop     // drop set — reduce weight and continue
  failure  // trained to failure
}

enum TrainerClientStatus {
  invited
  active
  paused
  ended
}

// ═════════════════════════════════════════════════════════════════════
// EXERCISE PREFERENCES
// User-specific preference state per exercise (separate from licensed
// ExerciseDB source records — never modify those).
// ═════════════════════════════════════════════════════════════════════

enum ExercisePreferenceState {
  favorite       // ♥ — shown first, quick access
  more_often     // surface more frequently
  normal         // default
  less_often     // deprioritize
  dont_recommend // exclude from suggestions
}

model ExercisePreference {
  id         String                  @id @default(uuid()) @db.Uuid
  userId     String                  @map("user_id") @db.Uuid
  exerciseId String                  @map("exercise_id") @db.VarChar(100)
  state      ExercisePreferenceState @default(normal)
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([userId])
  @@index([userId, state])
  @@map("exercise_preferences")
}

// ═════════════════════════════════════════════════════════════════════
// EQUIPMENT PROFILES
// Named collections of available equipment per location.
// Drives exercise filtering and (future) V workout generation.
// ═════════════════════════════════════════════════════════════════════

model EquipmentProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   EquipmentProfileItem[]

  @@index([userId])
  @@map("equipment_profiles")
}

model EquipmentProfileItem {
  id        String           @id @default(uuid()) @db.Uuid
  profileId String           @map("profile_id") @db.Uuid
  equipment String           @db.VarChar(100)

  profile EquipmentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, equipment])
  @@index([profileId])
  @@map("equipment_profile_items")
}

// ═════════════════════════════════════════════════════════════════════
// WEEKLY TARGETS
// Per-user configurable weekly volume/consistency targets.
// ═════════════════════════════════════════════════════════════════════

enum WeeklyTargetType {
  workouts_per_week
  training_days
  nutrition_log_days
  protein_target_days
}

model WeeklyTarget {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  targetType  WeeklyTargetType @map("target_type")
  targetValue Int              @map("target_value")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType])
  @@index([userId])
  @@map("weekly_targets")
}

