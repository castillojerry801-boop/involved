// Involved — Prisma Schema
// Database: Supabase PostgreSQL
// Run `npx prisma db push` after setting DATABASE_URL in .env.local

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═════════════════════════════════════════════════════════════════════
// USER PROFILE
// Extends Supabase auth.users. Created automatically via DB trigger
// on first sign-up. id matches auth.users.id.
// ═════════════════════════════════════════════════════════════════════

model Profile {
  id               String           @id @db.Uuid
  username         String?          @unique @db.VarChar(30)
  displayName      String?          @map("display_name") @db.VarChar(100)
  avatarUrl        String?          @map("avatar_url")
  bio              String?          @db.VarChar(500)
  dateOfBirth      DateTime?        @map("date_of_birth") @db.Date
  heightCm         Decimal?         @map("height_cm") @db.Decimal(5, 1)
  weightKg         Decimal?         @map("weight_kg") @db.Decimal(5, 1)
  fitnessLevel     FitnessLevel?    @map("fitness_level")
  subscriptionTier SubscriptionTier @default(free) @map("subscription_tier")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Core relations
  goals               Goal[]
  aiUsageLogs         AiUsageLog[]
  subscription        UserSubscription?
  entitlements        UserEntitlement[]

  // Training
  workouts            Workout[]
  personalRecords     PersonalRecord[]
  programs            Program[]
  workoutTemplates    WorkoutTemplate[]
  exercisePreferences    ExercisePreference[]
  equipmentProfiles      EquipmentProfile[]
  weeklyTargets          WeeklyTarget[]
  customExercises        CustomExercise[]
  exerciseBehaviorEvents ExerciseBehaviorEvent[]

  // Trainer
  trainerProfile      TrainerProfile?
  trainerSubscription TrainerSubscription?
  clientOf            TrainerClientRelationship[] @relation("ClientTrainers")
  trainerNotes        TrainerNote[]               @relation("ClientNotes")
  clientTargets       TrainerClientTarget[]       @relation("ClientTargets")
  clientDrafts        VTrainerDraft[]             @relation("ClientDrafts")

  // Nutrition
  createdFoods     FoodItem[]       @relation("FoodItemsCreated")
  foodLogEntries   FoodLogEntry[]
  nutritionTargets NutritionTarget[]
  foodFavorites    FoodFavorite[]
  savedMeals       SavedMeal[]

  // Health / wearable
  healthActivities HealthActivity[]
  healthMetrics    HealthMetric[]
  healthSyncCursors HealthSyncCursor[]
  healthPermissions HealthPermission[]

  // Photos
  progressPhotos   ProgressPhoto[]

  @@map("profiles")
}

// ─── Progress Photos ──────────────────────────────────────────────────

model ProgressPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  storageKey String   @map("storage_key")
  url        String
  note       String?  @db.VarChar(500)
  takenAt    DateTime @default(now()) @map("taken_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("progress_photos")
}

// ═════════════════════════════════════════════════════════════════════
// GOALS
// ═════════════════════════════════════════════════════════════════════

model Goal {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  type        GoalType
  title       String     @db.VarChar(200)
  description String?    @db.VarChar(1000)
  targetDate  DateTime?  @map("target_date") @db.Date
  status      GoalStatus @default(active)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

// ═════════════════════════════════════════════════════════════════════
// AI USAGE LOGS
// ═════════════════════════════════════════════════════════════════════

model AiUsageLog {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  billingPeriod    String     @map("billing_period") @db.VarChar(7) // "2026-09"
  feature          AiFeature  @default(coach_message)
  interactionCount Int        @default(0) @map("interaction_count")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, billingPeriod, feature])
  @@index([userId])
  @@map("ai_usage_logs")
}

// ═════════════════════════════════════════════════════════════════════
// SUBSCRIPTIONS & ENTITLEMENTS
// ═════════════════════════════════════════════════════════════════════

model UserSubscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @unique @map("user_id") @db.Uuid
  tier                   SubscriptionTier   @default(free)
  status                 SubscriptionStatus @default(active)
  billingSource          BillingSource?     @map("billing_source")
  externalSubscriptionId String?            @map("external_subscription_id") @db.VarChar(255)
  externalPriceId        String?            @map("external_price_id") @db.VarChar(255)
  trialStartedAt         DateTime?          @map("trial_started_at") @db.Timestamptz(3)
  trialEndsAt            DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_subscriptions")
}

// Multi-source entitlement records. A user may have overlapping entitlements
// from personal Plus, trainer sponsorship, promos, etc.
// Resolver in lib/subscription/entitlements.ts picks the effective tier.
model UserEntitlement {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  source    UserEntitlementSource
  status    UserEntitlementStatus @default(active)
  // Foreign reference to the granting entity (trainerId, subscriptionId, promoCode)
  sourceRef String?               @map("source_ref") @db.VarChar(200)
  grantedAt DateTime              @default(now()) @map("granted_at") @db.Timestamptz(3)
  expiresAt DateTime?             @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime?             @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, source])
  @@index([sourceRef])
  @@map("user_entitlements")
}

// Trainer-specific seat-based subscription — separate from UserSubscription
model TrainerSubscription {
  id                     String                    @id @default(uuid()) @db.Uuid
  userId                 String                    @unique @map("user_id") @db.Uuid
  tierKey                String                    @map("tier_key") @db.VarChar(50) // trainer_10|trainer_20|trainer_50
  maxClients             Int                       @map("max_clients")
  status                 TrainerSubscriptionStatus @default(active)
  billingSource          BillingSource?            @map("billing_source")
  externalSubscriptionId String?                   @map("external_subscription_id") @db.VarChar(255)
  externalPriceId        String?                   @map("external_price_id") @db.VarChar(255)
  currentPeriodStart     DateTime?                 @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime?                 @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean                   @default(false) @map("cancel_at_period_end")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trainer_subscriptions")
}

// ═════════════════════════════════════════════════════════════════════
// NUTRITION — FOOD LIBRARY
// ═════════════════════════════════════════════════════════════════════

model FoodItem {
  id          String @id @default(uuid()) @db.Uuid

  name        String  @db.VarChar(300)
  brand       String? @db.VarChar(200)
  barcode     String? @db.VarChar(50)

  sourceCategory  FoodSourceCategory @map("source_category")
  sourceProvider  String?            @map("source_provider") @db.VarChar(100)
  externalId      String?            @map("external_id") @db.VarChar(200)
  lastSyncedAt    DateTime?          @map("last_synced_at")

  visibility    FoodVisibility @default(private_food)
  createdById   String?        @map("created_by_id") @db.Uuid
  verifiedAt    DateTime?      @map("verified_at")
  verifiedById  String?        @map("verified_by_id") @db.Uuid
  duplicateOfId String?        @map("duplicate_of_id") @db.Uuid

  servingSize          Decimal  @map("serving_size") @db.Decimal(10, 3)
  servingUnit          String   @map("serving_unit") @db.VarChar(50)
  servingsPerContainer Decimal? @map("servings_per_container") @db.Decimal(8, 2)

  calories      Decimal @db.Decimal(8, 2)
  proteinG      Decimal @map("protein_g") @db.Decimal(8, 3)
  carbohydrateG Decimal @map("carbohydrate_g") @db.Decimal(8, 3)
  fatG          Decimal @map("fat_g") @db.Decimal(8, 3)

  nutrientsJson Json? @map("nutrients_json")
  ingredientsText String? @map("ingredients_text") @db.Text
  isDraft Boolean @default(false) @map("is_draft")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdBy      Profile?       @relation("FoodItemsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  duplicateOf    FoodItem?      @relation("FoodDuplicates", fields: [duplicateOfId], references: [id])
  duplicatedBy   FoodItem[]     @relation("FoodDuplicates")
  foodLogEntries FoodLogEntry[]
  foodFavorites  FoodFavorite[]
  savedMealItems SavedMealItem[]

  @@index([name])
  @@index([barcode])
  @@index([sourceCategory, sourceProvider, externalId])
  @@index([visibility, createdById])
  @@map("food_items")
}

model FoodLogEntry {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  foodItemId        String?  @map("food_item_id") @db.Uuid

  logDate           DateTime @map("log_date") @db.Date
  loggedAt          DateTime @default(now()) @map("logged_at") @db.Timestamptz(3)

  mealType          MealType @map("meal_type")
  servingMultiplier Decimal  @map("serving_multiplier") @db.Decimal(8, 3)
  notes             String?  @db.VarChar(500)

  snapshotFoodName                String   @map("snapshot_food_name") @db.VarChar(300)
  snapshotServingSize             Decimal  @map("snapshot_serving_size") @db.Decimal(10, 3)
  snapshotServingUnit             String   @map("snapshot_serving_unit") @db.VarChar(50)
  snapshotCaloriesPerServing      Decimal  @map("snapshot_calories_per_serving") @db.Decimal(8, 2)
  snapshotProteinGPerServing      Decimal  @map("snapshot_protein_g_per_serving") @db.Decimal(8, 3)
  snapshotCarbohydrateGPerServing Decimal  @map("snapshot_carbohydrate_g_per_serving") @db.Decimal(8, 3)
  snapshotFatGPerServing          Decimal  @map("snapshot_fat_g_per_serving") @db.Decimal(8, 3)
  snapshotNutrientsJson           Json?    @map("snapshot_nutrients_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile  Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  @@index([userId, logDate])
  @@index([userId, mealType])
  @@map("food_log_entries")
}

model NutritionTarget {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  effectiveDate DateTime @map("effective_date") @db.Date

  calories      Decimal @db.Decimal(8, 2)
  proteinG      Decimal @map("protein_g") @db.Decimal(8, 2)
  carbohydrateG Decimal @map("carbohydrate_g") @db.Decimal(8, 2)
  fatG          Decimal @map("fat_g") @db.Decimal(8, 2)
  fiberG        Decimal? @map("fiber_g") @db.Decimal(8, 2)
  sugarG        Decimal? @map("sugar_g") @db.Decimal(8, 2)
  sodiumMg      Decimal? @map("sodium_mg") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveDate])
  @@map("nutrition_targets")
}

model FoodFavorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  foodItemId String   @map("food_item_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  profile  Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@unique([userId, foodItemId])
  @@index([userId])
  @@map("food_favorites")
}

model SavedMeal {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  name      String          @db.VarChar(200)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  profile Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   SavedMealItem[]

  @@index([userId])
  @@map("saved_meals")
}

model SavedMealItem {
  id                String    @id @default(uuid()) @db.Uuid
  savedMealId       String    @map("saved_meal_id") @db.Uuid
  foodItemId        String    @map("food_item_id") @db.Uuid
  servingMultiplier Decimal   @map("serving_multiplier") @db.Decimal(8, 3)
  mealType          MealType  @map("meal_type")
  sortOrder         Int       @default(0) @map("sort_order")

  savedMeal SavedMeal @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  foodItem  FoodItem  @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@index([savedMealId])
  @@map("saved_meal_items")
}

// ═════════════════════════════════════════════════════════════════════
// TRAINING PROGRAMS
// ═════════════════════════════════════════════════════════════════════

model Program {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  name        String      @db.VarChar(200)
  description String?     @db.VarChar(500)
  isActive    Boolean     @default(false) @map("is_active")
  // Set when a trainer assigns this program to a client
  trainerCreatedById    String?   @map("trainer_created_by_id") @db.Uuid
  sourceTrainerProgramId String?  @map("source_trainer_program_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  profile             Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceTrainerProgram TrainerProgram? @relation("AssignedFromTrainerProgram", fields: [sourceTrainerProgramId], references: [id], onDelete: SetNull)
  days                ProgramDay[]

  @@index([userId])
  @@index([trainerCreatedById])
  @@map("programs")
}

model ProgramDay {
  id        String            @id @default(uuid()) @db.Uuid
  programId String            @map("program_id") @db.Uuid
  name      String            @db.VarChar(200)
  sortOrder Int               @default(0) @map("sort_order")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  program   Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises ProgramExercise[]
  workouts  Workout[]

  @@index([programId])
  @@map("program_days")
}

model ProgramExercise {
  id           String       @id @default(uuid()) @db.Uuid
  programDayId String       @map("program_day_id") @db.Uuid
  exerciseId   String       @map("exercise_id") @db.VarChar(100)
  sortOrder    Int          @default(0) @map("sort_order")
  trackingType TrackingType @default(strength) @map("tracking_type")
  notes        String?      @db.VarChar(500)
  restSeconds  Int?         @map("rest_seconds")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  programDay ProgramDay   @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  sets       ProgramSet[]

  @@index([programDayId])
  @@map("program_exercises")
}

model ProgramSet {
  id                    String   @id @default(uuid()) @db.Uuid
  programExerciseId     String   @map("program_exercise_id") @db.Uuid
  setNumber             Int      @map("set_number")
  setType               SetType  @default(working) @map("set_type")
  targetRepsMin         Int?     @map("target_reps_min")
  targetRepsMax         Int?     @map("target_reps_max")
  targetWeightKg        Decimal? @map("target_weight_kg") @db.Decimal(7, 2)
  targetWeightPercent   Int?     @map("target_weight_percent")
  targetDurationSeconds Int?     @map("target_duration_seconds")
  targetDistanceM       Decimal? @map("target_distance_m") @db.Decimal(10, 2)
  targetRir             Int?     @map("target_rir")
  restSeconds           Int?     @map("rest_seconds")
  notes                 String?  @db.VarChar(300)
  createdAt             DateTime @default(now()) @map("created_at")

  programExercise ProgramExercise @relation(fields: [programExerciseId], references: [id], onDelete: Cascade)

  @@index([programExerciseId])
  @@map("program_sets")
}

// ═════════════════════════════════════════════════════════════════════
// WORKOUT TEMPLATES
// ═════════════════════════════════════════════════════════════════════

model WorkoutTemplate {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  name               String             @db.VarChar(200)
  description        String?            @db.VarChar(500)
  equipmentProfileId String?            @map("equipment_profile_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  profile          Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipmentProfile EquipmentProfile?  @relation(fields: [equipmentProfileId], references: [id], onDelete: SetNull)
  exercises        TemplateExercise[]
  workouts         Workout[]

  @@index([userId])
  @@map("workout_templates")
}

model TemplateExercise {
  id           String          @id @default(uuid()) @db.Uuid
  templateId   String          @map("template_id") @db.Uuid
  exerciseId   String          @map("exercise_id") @db.VarChar(100)
  sortOrder    Int             @default(0) @map("sort_order")
  trackingType TrackingType    @default(strength) @map("tracking_type")
  notes        String?         @db.VarChar(500)
  restSeconds  Int?            @map("rest_seconds")
  createdAt    DateTime        @default(now()) @map("created_at")

  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sets     TemplateSet[]

  @@index([templateId])
  @@map("template_exercises")
}

model TemplateSet {
  id                    String          @id @default(uuid()) @db.Uuid
  templateExerciseId    String          @map("template_exercise_id") @db.Uuid
  setNumber             Int             @map("set_number")
  setType               SetType         @default(working) @map("set_type")
  targetRepsMin         Int?            @map("target_reps_min")
  targetRepsMax         Int?            @map("target_reps_max")
  targetWeightKg        Decimal?        @map("target_weight_kg") @db.Decimal(7, 2)
  targetDurationSeconds Int?            @map("target_duration_seconds")
  targetDistanceM       Decimal?        @map("target_distance_m") @db.Decimal(10, 2)
  restSeconds           Int?            @map("rest_seconds")
  notes                 String?         @db.VarChar(300)
  createdAt             DateTime        @default(now()) @map("created_at")

  templateExercise TemplateExercise @relation(fields: [templateExerciseId], references: [id], onDelete: Cascade)

  @@index([templateExerciseId])
  @@map("template_sets")
}

// ═════════════════════════════════════════════════════════════════════
// WORKOUTS — active/completed sessions
// ═════════════════════════════════════════════════════════════════════

model Workout {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  assignedById    String?       @map("assigned_by_id") @db.Uuid
  templateId      String?       @map("template_id") @db.Uuid
  programDayId    String?       @map("program_day_id") @db.Uuid
  title           String        @db.VarChar(200)
  notes           String?       @db.Text
  scheduledDate   DateTime?     @map("scheduled_date") @db.Date
  status          WorkoutStatus @default(planned)
  source          WorkoutSource @default(manual)
  startedAt       DateTime?     @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(3)
  durationSeconds       Int?    @map("duration_seconds")
  durationTargetMinutes Int?    @map("duration_target_minutes")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  profile         Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises       WorkoutExercise[]
  personalRecords PersonalRecord[]
  template        WorkoutTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  programDay      ProgramDay?       @relation(fields: [programDayId], references: [id], onDelete: SetNull)
  healthActivity  HealthActivity?   @relation("WorkoutHealthActivity")

  @@index([userId, scheduledDate])
  @@index([userId, status])
  @@index([userId, completedAt])
  @@index([templateId])
  @@index([programDayId])
  @@map("workouts")
}

model WorkoutExercise {
  id           String       @id @default(uuid()) @db.Uuid
  workoutId    String       @map("workout_id") @db.Uuid
  exerciseId   String       @map("exercise_id") @db.VarChar(100)
  order        Int          @default(0)
  notes        String?      @db.VarChar(500)
  targetSets   Int?         @map("target_sets")
  trackingType TrackingType @default(strength) @map("tracking_type")
  restSeconds  Int?         @map("rest_seconds")
  createdAt    DateTime     @default(now()) @map("created_at")

  workout Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sets    WorkoutSet[]

  @@index([workoutId])
  @@map("workout_exercises")
}

model WorkoutSet {
  id                    String    @id @default(uuid()) @db.Uuid
  workoutExerciseId     String    @map("workout_exercise_id") @db.Uuid
  setNumber             Int       @map("set_number")
  setType               SetType   @default(working) @map("set_type")
  targetReps            Int?      @map("target_reps")
  targetRepsMin         Int?      @map("target_reps_min")
  targetRepsMax         Int?      @map("target_reps_max")
  targetWeightKg        Decimal?  @map("target_weight_kg") @db.Decimal(7, 2)
  targetDurationSeconds Int?      @map("target_duration_seconds")
  targetDistanceM       Decimal?  @map("target_distance_m") @db.Decimal(10, 2)
  actualReps            Int?      @map("actual_reps")
  actualWeightKg        Decimal?  @map("actual_weight_kg") @db.Decimal(7, 2)
  actualDurationSeconds Int?      @map("actual_duration_seconds")
  actualDistanceM       Decimal?  @map("actual_distance_m") @db.Decimal(10, 2)
  rpe                   Int?
  rir                   Int?
  restSeconds           Int?      @map("rest_seconds")
  completed             Boolean   @default(false)
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  personalRecord  PersonalRecord?

  @@index([workoutExerciseId])
  @@map("workout_sets")
}

model PersonalRecord {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  exerciseId   String   @map("exercise_id") @db.VarChar(100)
  metric       PRMetric
  value        Decimal  @db.Decimal(10, 3)
  unit         String   @db.VarChar(20)
  achievedAt   DateTime @map("achieved_at") @db.Timestamptz(3)
  workoutId    String?  @map("workout_id") @db.Uuid
  workoutSetId String?  @unique @map("workout_set_id") @db.Uuid

  profile    Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout    Workout?    @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  workoutSet WorkoutSet? @relation(fields: [workoutSetId], references: [id], onDelete: SetNull)

  @@index([userId, exerciseId, metric])
  @@map("personal_records")
}

// ═════════════════════════════════════════════════════════════════════
// TRAINER SYSTEM
// ═════════════════════════════════════════════════════════════════════

model TrainerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  bio       String?  @db.VarChar(500)
  specialty String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile     Profile                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clients     TrainerClientRelationship[] @relation("TrainerClients")
  invitations TrainerInvitation[]         @relation("TrainerInvitations")
  programs    TrainerProgram[]            @relation("TrainerPrograms")
  notes       TrainerNote[]               @relation("TrainerNotes")
  targets     TrainerClientTarget[]       @relation("TrainerTargets")
  drafts      VTrainerDraft[]             @relation("TrainerDrafts")

  @@map("trainer_profiles")
}

model TrainerClientRelationship {
  id                   String              @id @default(uuid()) @db.Uuid
  trainerId            String              @map("trainer_id") @db.Uuid
  clientId             String              @map("client_id") @db.Uuid
  status               TrainerClientStatus @default(invited)
  // ID of the UserEntitlement granted to the client for this relationship
  sponsoredEntitlementId String?           @map("sponsored_entitlement_id") @db.Uuid
  invitedAt            DateTime            @default(now()) @map("invited_at")
  acceptedAt           DateTime?           @map("accepted_at")
  revokedAt            DateTime?           @map("revoked_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  trainer TrainerProfile @relation("TrainerClients", fields: [trainerId], references: [userId], onDelete: Cascade)
  client  Profile        @relation("ClientTrainers", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([trainerId, clientId])
  @@index([trainerId])
  @@index([clientId])
  @@index([status])
  @@map("trainer_client_relationships")
}

// Pending invitations sent by email — no data access granted until accepted
model TrainerInvitation {
  id               String                  @id @default(uuid()) @db.Uuid
  trainerId        String                  @map("trainer_id") @db.Uuid
  invitedEmail     String                  @map("invited_email") @db.VarChar(255)
  token            String                  @unique @db.VarChar(64)
  status           TrainerInvitationStatus @default(pending)
  sentAt           DateTime                @default(now()) @map("sent_at") @db.Timestamptz(3)
  expiresAt        DateTime                @map("expires_at") @db.Timestamptz(3)
  acceptedByUserId String?                 @map("accepted_by_user_id") @db.Uuid
  acceptedAt       DateTime?               @map("accepted_at") @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  trainer TrainerProfile @relation("TrainerInvitations", fields: [trainerId], references: [userId], onDelete: Cascade)

  @@index([trainerId])
  @@index([token])
  @@index([invitedEmail])
  @@map("trainer_invitations")
}

// Trainer's reusable program template library — never mutated by client assignment
model TrainerProgram {
  id              String       @id @default(uuid()) @db.Uuid
  trainerId       String       @map("trainer_id") @db.Uuid
  name            String       @db.VarChar(200)
  description     String?      @db.VarChar(1000)
  level           FitnessLevel?
  durationWeeks   Int?         @map("duration_weeks")
  sessionsPerWeek Int?         @map("sessions_per_week")
  isArchived      Boolean      @default(false) @map("is_archived")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  trainer     TrainerProfile     @relation("TrainerPrograms", fields: [trainerId], references: [userId], onDelete: Cascade)
  days        TrainerProgramDay[]
  assignments Program[]          @relation("AssignedFromTrainerProgram")

  @@index([trainerId])
  @@map("trainer_programs")
}

model TrainerProgramDay {
  id        String   @id @default(uuid()) @db.Uuid
  programId String   @map("program_id") @db.Uuid
  name      String   @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  program   TrainerProgram          @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises TrainerProgramExercise[]

  @@index([programId])
  @@map("trainer_program_days")
}

model TrainerProgramExercise {
  id           String       @id @default(uuid()) @db.Uuid
  programDayId String       @map("program_day_id") @db.Uuid
  exerciseId   String       @map("exercise_id") @db.VarChar(100)
  sortOrder    Int          @default(0) @map("sort_order")
  trackingType TrackingType @default(strength) @map("tracking_type")
  notes        String?      @db.VarChar(500)
  restSeconds  Int?         @map("rest_seconds")
  createdAt    DateTime     @default(now()) @map("created_at")

  programDay TrainerProgramDay    @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  sets       TrainerProgramSet[]

  @@index([programDayId])
  @@map("trainer_program_exercises")
}

model TrainerProgramSet {
  id                    String   @id @default(uuid()) @db.Uuid
  programExerciseId     String   @map("program_exercise_id") @db.Uuid
  setNumber             Int      @map("set_number")
  setType               SetType  @default(working) @map("set_type")
  targetRepsMin         Int?     @map("target_reps_min")
  targetRepsMax         Int?     @map("target_reps_max")
  targetWeightKg        Decimal? @map("target_weight_kg") @db.Decimal(7, 2)
  targetWeightPercent   Int?     @map("target_weight_percent")
  targetDurationSeconds Int?     @map("target_duration_seconds")
  targetDistanceM       Decimal? @map("target_distance_m") @db.Decimal(10, 2)
  targetRir             Int?     @map("target_rir")
  restSeconds           Int?     @map("rest_seconds")
  notes                 String?  @db.VarChar(300)
  createdAt             DateTime @default(now()) @map("created_at")

  programExercise TrainerProgramExercise @relation(fields: [programExerciseId], references: [id], onDelete: Cascade)

  @@index([programExerciseId])
  @@map("trainer_program_sets")
}

// Trainer notes on a client — isPrivate=true means client cannot see them
model TrainerNote {
  id        String   @id @default(uuid()) @db.Uuid
  trainerId String   @map("trainer_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  content   String   @db.Text
  isPrivate Boolean  @default(true) @map("is_private")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trainer TrainerProfile @relation("TrainerNotes", fields: [trainerId], references: [userId], onDelete: Cascade)
  client  Profile        @relation("ClientNotes", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([trainerId, clientId])
  @@map("trainer_notes")
}

// Targets a trainer sets for a specific client
model TrainerClientTarget {
  id            String                  @id @default(uuid()) @db.Uuid
  trainerId     String                  @map("trainer_id") @db.Uuid
  clientId      String                  @map("client_id") @db.Uuid
  targetType    TrainerClientTargetType @map("target_type")
  targetValue   Decimal                 @map("target_value") @db.Decimal(10, 3)
  unit          String                  @db.VarChar(50)
  notes         String?                 @db.VarChar(500)
  effectiveDate DateTime                @map("effective_date") @db.Date
  createdAt     DateTime                @default(now()) @map("created_at")

  trainer TrainerProfile @relation("TrainerTargets", fields: [trainerId], references: [userId], onDelete: Cascade)
  client  Profile        @relation("ClientTargets", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([trainerId, clientId])
  @@index([clientId, targetType])
  @@map("trainer_client_targets")
}

// V trainer drafts — pending approval queue for AI-generated changes
// Trainer must approve, edit, or dismiss before any change is applied.
model VTrainerDraft {
  id          String       @id @default(uuid()) @db.Uuid
  trainerId   String       @map("trainer_id") @db.Uuid
  clientId    String       @map("client_id") @db.Uuid
  draftType   VDraftType   @map("draft_type")
  description String       @db.VarChar(500)
  payload     Json
  status      VDraftStatus @default(pending)
  createdAt   DateTime     @default(now()) @map("created_at")
  reviewedAt  DateTime?    @map("reviewed_at") @db.Timestamptz(3)

  trainer TrainerProfile @relation("TrainerDrafts", fields: [trainerId], references: [userId], onDelete: Cascade)
  client  Profile        @relation("ClientDrafts", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([trainerId, status])
  @@index([clientId, status])
  @@map("v_trainer_drafts")
}

// ═════════════════════════════════════════════════════════════════════
// HEALTH / ACTIVITY LAYER
// Normalized representation of data from wearables and health platforms.
// Provider-agnostic: Apple Health, Android Health Connect, Garmin, etc.
// Native platform bridges push data to these tables via the sync API.
// ═════════════════════════════════════════════════════════════════════

// A single workout/activity session recorded by a health platform.
// externalId + provider dedup prevents duplicate imports.
// PostgreSQL UNIQUE allows multiple NULLs, so manual records (externalId=null)
// are always allowed; only non-null externalIds are deduplicated.
model HealthActivity {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  provider         HealthProvider
  externalId       String?            @map("external_id") @db.VarChar(500)
  activityType     HealthActivityType @map("activity_type")
  title            String?            @db.VarChar(200)
  startedAt        DateTime           @map("started_at") @db.Timestamptz(3)
  endedAt          DateTime?          @map("ended_at") @db.Timestamptz(3)
  durationSeconds  Int?               @map("duration_seconds")
  activeEnergyKcal Decimal?           @map("active_energy_kcal") @db.Decimal(8, 2)
  totalEnergyKcal  Decimal?           @map("total_energy_kcal") @db.Decimal(8, 2)
  distanceM        Decimal?           @map("distance_m") @db.Decimal(10, 2)
  stepCount        Int?               @map("step_count")
  avgHeartRateBpm  Int?               @map("avg_heart_rate_bpm")
  maxHeartRateBpm  Int?               @map("max_heart_rate_bpm")
  // Link to an Involved workout if this activity was matched or written back (one-to-one)
  involvedWorkoutId String?           @unique @map("involved_workout_id") @db.Uuid
  syncState        HealthSyncState    @default(synced) @map("sync_state")
  syncedAt         DateTime           @default(now()) @map("synced_at") @db.Timestamptz(3)
  // Provider-specific extras stored without schema coupling
  rawMetadataJson  Json?              @map("raw_metadata_json")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  profile         Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  involvedWorkout Workout? @relation("WorkoutHealthActivity", fields: [involvedWorkoutId], references: [id], onDelete: SetNull)

  @@unique([userId, provider, externalId])
  @@index([userId, startedAt])
  @@index([userId, provider])
  @@index([involvedWorkoutId])
  @@map("health_activities")
}

// Point-in-time or period-aggregate health metrics.
// Separate from HealthActivity because steps/HR/weight are not activities.
model HealthMetric {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  provider    HealthProvider
  externalId  String?          @map("external_id") @db.VarChar(500)
  metricType  HealthMetricType @map("metric_type")
  value       Decimal          @db.Decimal(12, 4)
  unit        String           @db.VarChar(20)
  // For point-in-time readings (body weight, spot HR check)
  recordedAt  DateTime         @map("recorded_at") @db.Timestamptz(3)
  // For aggregated periods (daily steps, active energy total)
  periodStart DateTime?        @map("period_start") @db.Timestamptz(3)
  periodEnd   DateTime?        @map("period_end") @db.Timestamptz(3)
  syncState   HealthSyncState  @default(synced) @map("sync_state")
  syncedAt    DateTime         @default(now()) @map("synced_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, metricType, recordedAt])
  @@index([userId, metricType, recordedAt])
  @@index([userId, provider])
  @@map("health_metrics")
}

// Per-provider sync cursor — tracks where each data stream left off.
// lastAnchor is provider-specific (ISO date string, opaque token, etc.)
model HealthSyncCursor {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  provider     HealthProvider
  dataType     String         @map("data_type") @db.VarChar(100)
  lastSyncedAt DateTime?      @map("last_synced_at") @db.Timestamptz(3)
  lastAnchor   String?        @map("last_anchor") @db.VarChar(1000)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, dataType])
  @@index([userId])
  @@map("health_sync_cursors")
}

// Records which health data types the user has explicitly granted.
// Permissions are opt-in, granular, and revocable.
model HealthPermission {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  provider  HealthProvider
  dataType  String         @map("data_type") @db.VarChar(100)
  granted   Boolean        @default(false)
  grantedAt DateTime?      @map("granted_at") @db.Timestamptz(3)
  revokedAt DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, dataType])
  @@index([userId])
  @@map("health_permissions")
}

// ═════════════════════════════════════════════════════════════════════
// EXERCISE PREFERENCES
// ═════════════════════════════════════════════════════════════════════

model ExercisePreference {
  id         String                  @id @default(uuid()) @db.Uuid
  userId     String                  @map("user_id") @db.Uuid
  exerciseId String                  @map("exercise_id") @db.VarChar(100)
  state      ExercisePreferenceState @default(normal)
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([userId])
  @@index([userId, state])
  @@map("exercise_preferences")
}

// ═════════════════════════════════════════════════════════════════════
// EQUIPMENT PROFILES
// ═════════════════════════════════════════════════════════════════════

model EquipmentProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile   Profile               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     EquipmentProfileItem[]
  templates WorkoutTemplate[]

  @@index([userId])
  @@map("equipment_profiles")
}

model EquipmentProfileItem {
  id               String           @id @default(uuid()) @db.Uuid
  profileId        String           @map("profile_id") @db.Uuid
  equipment        String           @db.VarChar(100)
  // Stores available loads/increments for this equipment at this location.
  // Shape: { unit: "lbs"|"kg", type: "fixed"|"range", values?: number[], min?: number, max?: number, increment?: number }
  availableWeights Json?            @map("available_weights")

  profile EquipmentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, equipment])
  @@index([profileId])
  @@map("equipment_profile_items")
}

// ═════════════════════════════════════════════════════════════════════
// EXERCISE BEHAVIOR EVENTS
// ═════════════════════════════════════════════════════════════════════
// Lightweight signals for future V logic. These are NOT automatically
// converted into exercise preferences. Explicit preferences and
// behavioral signals are separate concepts.

model ExerciseBehaviorEvent {
  id          String                    @id @default(uuid()) @db.Uuid
  userId      String                    @map("user_id") @db.Uuid
  exerciseId  String                    @map("exercise_id") @db.VarChar(100)
  event       ExerciseBehaviorEventType
  workoutId   String?                   @map("workout_id") @db.Uuid
  programId   String?                   @map("program_id") @db.Uuid
  replacedBy  String?                   @map("replaced_by") @db.VarChar(100)
  createdAt   DateTime                  @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId])
  @@index([userId, createdAt])
  @@map("exercise_behavior_events")
}

// ═════════════════════════════════════════════════════════════════════
// WEEKLY TARGETS
// ═════════════════════════════════════════════════════════════════════

model WeeklyTarget {
